---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { WORKS, WORK_CATEGORIES, DRIVE_FOLDER_URL } from '../data/portfolio';
import bgOptical from '../assets/bg-futuristic-optical.jpg';

const thumbnailModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/thumbnails/*.jpg',
  { eager: true }
);

function getThumbnail(key: string): ImageMetadata {
  const match = thumbnailModules[`../assets/thumbnails/${key}.jpg`];
  if (!match) {
    throw new Error(`Missing thumbnail asset for key: ${key}`);
  }
  return match.default;
}
---

<section
  id="works"
  class="relative bg-[#1E2522] text-[#D1E8E2] py-20 sm:py-28 border-b border-[#116466]/55 overflow-hidden"
>
  <!-- Matching Futuristic Optical Lens Backdrop -->
  <Image
    src={bgOptical}
    alt=""
    widths={[768, 1376]}
    sizes="100vw"
    aria-hidden="true"
    class="absolute inset-0 w-full h-full object-cover opacity-28 pointer-events-none select-none"
    loading="lazy"
  />
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse 70% 55% at 80% 15%, rgba(17, 100, 102, 0.25), transparent 65%), linear-gradient(180deg, rgba(30, 37, 34, 0.86) 0%, rgba(30, 37, 34, 0.65) 50%, rgba(30, 37, 34, 0.92) 100%);"
    aria-hidden="true"
  ></div>
  <div class="absolute inset-0 futuristic-grid opacity-40" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6">
    <!-- Section Header -->
    <div class="flex flex-wrap items-end justify-between gap-6 border-b border-[#116466]/70 pb-6 mb-10">
      <div>
        <p class="text-xs uppercase tracking-[0.22em] text-[#FFCB9A] font-semibold mb-2">
          02 // WORKS DONE
        </p>
        <h2
          class="font-display font-bold tracking-[0.015em] leading-[1.1] text-[#D1E8E2]"
          style="font-size: clamp(1.85rem, 3.6vw, 3rem);"
        >
          Curated Cuts, Trailers &amp; High-Retention Reels.
        </h2>
      </div>
      <span class="text-xs uppercase tracking-[0.16em] text-[#D9B08C]">
        TAP ANY CUT TO WATCH
      </span>
    </div>

    <!-- Category Filter Chips -->
    <div
      class="flex flex-wrap items-center gap-2.5 mb-8"
      role="tablist"
      aria-label="Filter portfolio works by category"
    >
      {WORK_CATEGORIES.map((category, idx) => (
        <button
          type="button"
          role="tab"
          aria-selected={idx === 0 ? 'true' : 'false'}
          data-filter-btn={category}
          class:list={[
            'filter-chip rounded-full border px-4 py-1.5 text-xs sm:text-sm font-medium tracking-wide transition-all cursor-pointer',
            idx === 0
              ? 'border-[#FFCB9A] bg-[#FFCB9A] text-[#1E2522] font-semibold shadow-[0_6px_18px_rgba(255,203,154,0.28)]'
              : 'border-[#116466] bg-[#2C3531]/75 text-[#D1E8E2]/85 hover:border-[#FFCB9A] hover:text-[#FFCB9A]',
          ]}
        >
          {category}
        </button>
      ))}
      <span
        id="works-count-label"
        class="ml-auto font-mono-tech text-[11px] uppercase tracking-[0.14em] text-[#D9B08C]"
      >
        SHOWING {WORKS.length} / {WORKS.length} CUTS
      </span>
    </div>

    <!-- 16:9 Static Thumbnail Video Cards Grid (Zero 404 MP4 dependencies) -->
    <div
      id="works-grid"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
    >
      {WORKS.map((work) => {
        const thumb = getThumbnail(work.thumbnailKey);
        return (
          <article
            data-work-card
            data-category={work.category}
            class="work-card group rounded-2xl border border-[#116466]/80 hover:border-[#FFCB9A] bg-[#2C3531]/80 backdrop-blur-sm overflow-hidden transition-all duration-300 hover:-translate-y-1 flex flex-col shadow-[0_14px_36px_rgba(0,0,0,0.34)]"
          >
            <!-- 16:9 Media Stage -->
            <button
              type="button"
              data-open-modal
              data-drive-id={work.driveFileId}
              data-title={work.title}
              data-client={work.client}
              data-category={work.category}
              data-duration={work.duration}
              data-role={work.role}
              data-summary={work.summary}
              aria-label={`Play ${work.title} (${work.duration})`}
              class="relative aspect-video w-full overflow-hidden bg-[#1E2522] text-left cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFCB9A]"
            >
              <Image
                src={thumb}
                alt={`${work.title} — ${work.category} frame`}
                widths={[480, 768]}
                sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />

              <!-- Subtle Vignette -->
              <div
                class="absolute inset-0 bg-gradient-to-t from-[#1E2522]/90 via-[#1E2522]/20 to-transparent pointer-events-none"
                aria-hidden="true"
              ></div>

              <!-- Floating Category Tag -->
              <span class="absolute top-3 left-3 rounded-full border border-[#116466] bg-[#1E2522]/85 backdrop-blur-sm px-2.5 py-0.5 text-[10px] uppercase tracking-wider text-[#FFCB9A] font-semibold">
                {work.category}
              </span>

              <!-- Floating Duration Badge -->
              <span class="absolute top-3 right-3 rounded-md border border-[#116466] bg-[#1E2522]/85 backdrop-blur-sm px-2 py-0.5 font-mono-tech text-[11px] font-medium text-[#D1E8E2]">
                {work.duration}
              </span>

              <!-- Center Play Button -->
              <span
                class="play-pill absolute inset-0 flex items-center justify-center pointer-events-none"
                aria-hidden="true"
              >
                <span class="flex items-center justify-center w-12 h-12 rounded-full bg-[#FFCB9A]/92 border border-[#D1E8E2]/80 text-[#1E2522] shadow-[0_8px_24px_rgba(0,0,0,0.55)] transition-transform duration-300 group-hover:scale-110 group-hover:bg-[#FFCB9A]">
                  <svg class="w-5 h-5 translate-x-0.5 fill-current" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </span>
              </span>

              <!-- Bottom Format Note -->
              <span class="absolute bottom-2.5 left-3 text-[10px] uppercase tracking-wider text-[#D1E8E2]/80">
                {work.aspectNote}
              </span>
            </button>

            <!-- Card Metadata Body -->
            <div class="p-5 flex-1 flex flex-col justify-between gap-3">
              <div>
                <div class="flex items-center justify-between gap-2 text-[11px] uppercase tracking-wider text-[#D9B08C] mb-1.5">
                  <span>{work.client}</span>
                  <span class="font-mono-tech text-[#D1E8E2]/70">{work.year}</span>
                </div>
                <h3 class="font-display font-bold text-lg text-[#D1E8E2] leading-snug group-hover:text-[#FFCB9A] transition-colors">
                  {work.title}
                </h3>
                <p class="mt-2 text-sm text-[#D1E8E2]/75 leading-relaxed line-clamp-2">
                  {work.summary}
                </p>
              </div>

              <div class="pt-3 border-t border-[#116466]/65 flex items-center justify-between gap-2">
                <span class="text-xs text-[#D1E8E2]/75 truncate">
                  {work.role}
                </span>
                <span class="text-xs uppercase tracking-wider font-semibold text-[#FFCB9A] shrink-0">
                  Play &rarr;
                </span>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <!-- Accessible Google Drive Preview <dialog> Modal with Fallback -->
  <dialog
    id="work-preview-dialog"
    aria-labelledby="modal-work-title"
    class="m-auto w-[min(94vw,920px)] max-h-[92vh] rounded-2xl border border-[#116466] bg-[#1E2522] text-[#D1E8E2] p-0 shadow-[0_32px_90px_rgba(0,0,0,0.88)] backdrop:bg-[#1E2522]/88 backdrop:backdrop-blur-md overflow-hidden open:flex open:flex-col"
  >
    <!-- Modal Header -->
    <div class="shrink-0 flex flex-wrap items-center justify-between gap-3 px-4 sm:px-6 py-3 border-b border-[#116466]/70 bg-[#2C3531]">
      <div class="min-w-0">
        <div class="flex items-center gap-2 text-[11px] uppercase tracking-wider text-[#FFCB9A] font-semibold">
          <span id="modal-work-category">Category</span>
          <span>&bull;</span>
          <span id="modal-work-duration" class="font-mono-tech text-[#D1E8E2]">00:00</span>
          <span>&bull;</span>
          <span id="modal-work-client" class="text-[#D9B08C]">Client</span>
        </div>
        <h3 id="modal-work-title" class="font-display font-bold text-base sm:text-lg text-[#D1E8E2] truncate mt-0.5">
          Video Preview
        </h3>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <a
          id="modal-drive-fallback"
          href={DRIVE_FOLDER_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full border border-[#116466] hover:border-[#FFCB9A] px-3.5 py-1.5 text-[11px] font-medium uppercase tracking-wider text-[#D1E8E2] hover:text-[#FFCB9A] transition-colors"
        >
          Open in Google Drive &#8599;
        </a>
        <button
          id="modal-close-btn"
          type="button"
          aria-label="Close video modal"
          class="rounded-full bg-[#FFCB9A] hover:bg-[#D9B08C] px-4 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-[#1E2522] transition-colors cursor-pointer"
        >
          Close [ESC]
        </button>
      </div>
    </div>

    <!-- Embedded Google Drive Preview Iframe (Viewport-Safe Height) -->
    <div
      id="modal-player-shell"
      class="relative w-full h-[min(64vh,520px)] bg-black p-2 sm:p-3 flex items-center justify-center overflow-hidden"
    >
      <iframe
        id="modal-drive-iframe"
        title="Google Drive video playback preview"
        src="about:blank"
        class="w-full h-full aspect-video border-0 rounded-xl bg-black"
        allow="autoplay; fullscreen"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>

    <!-- Modal Summary Footer -->
    <div class="shrink-0 px-4 sm:px-6 py-3 border-t border-[#116466]/65 bg-[#2C3531]/95 flex flex-wrap items-center justify-between gap-2 text-xs text-[#D1E8E2]/80">
      <p id="modal-work-summary" class="max-w-2xl"></p>
      <span id="modal-work-role" class="text-[11px] text-[#FFCB9A] font-medium"></span>
    </div>
  </dialog>
</section>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter-btn]');
  const workCards = document.querySelectorAll<HTMLElement>('[data-work-card]');
  const countLabel = document.getElementById('works-count-label');

  // Category Filtering
  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.dataset.filterBtn || 'All';

      filterButtons.forEach((b) => {
        const active = b === btn;
        b.setAttribute('aria-selected', String(active));
        b.classList.toggle('border-[#FFCB9A]', active);
        b.classList.toggle('bg-[#FFCB9A]', active);
        b.classList.toggle('text-[#1E2522]', active);
        b.classList.toggle('font-semibold', active);
        b.classList.toggle('shadow-[0_6px_18px_rgba(255,203,154,0.28)]', active);

        b.classList.toggle('border-[#116466]', !active);
        b.classList.toggle('bg-[#2C3531]/75', !active);
        b.classList.toggle('text-[#D1E8E2]/85', !active);
      });

      let visibleCount = 0;
      workCards.forEach((card) => {
        const matches = selected === 'All' || card.dataset.category === selected;
        card.classList.toggle('hidden', !matches);
        if (matches) visibleCount += 1;
      });

      if (countLabel) {
        countLabel.textContent = `SHOWING ${visibleCount} / ${workCards.length} CUTS`;
      }
    });
  });

  // Google Drive Iframe Playback Modal
  const dialog = document.getElementById('work-preview-dialog') as HTMLDialogElement | null;
  const iframe = document.getElementById('modal-drive-iframe') as HTMLIFrameElement | null;
  const closeBtn = document.getElementById('modal-close-btn');
  const modalTitle = document.getElementById('modal-work-title');
  const modalCategory = document.getElementById('modal-work-category');
  const modalDuration = document.getElementById('modal-work-duration');
  const modalClient = document.getElementById('modal-work-client');
  const modalSummary = document.getElementById('modal-work-summary');
  const modalRole = document.getElementById('modal-work-role');

  function closeModal() {
    if (!dialog) return;
    if (iframe) iframe.src = 'about:blank';
    if (dialog.open) dialog.close();
  }

  document.querySelectorAll<HTMLButtonElement>('[data-open-modal]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      if (!dialog || !iframe) return;
      const driveFileId = trigger.dataset.driveId || '';

      if (modalTitle) modalTitle.textContent = trigger.dataset.title || '';
      if (modalCategory) modalCategory.textContent = trigger.dataset.category || '';
      if (modalDuration) modalDuration.textContent = trigger.dataset.duration || '';
      if (modalClient) modalClient.textContent = trigger.dataset.client || '';
      if (modalSummary) modalSummary.textContent = trigger.dataset.summary || '';
      if (modalRole) modalRole.textContent = trigger.dataset.role || '';

      iframe.src = `https://drive.google.com/file/d/${driveFileId}/preview`;
      dialog.showModal();
    });
  });

  if (closeBtn) {
    closeBtn.addEventListener('click', closeModal);
  }

  if (dialog) {
    dialog.addEventListener('close', () => {
      if (iframe) iframe.src = 'about:blank';
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) {
        closeModal();
      }
    });
  }
</script>
