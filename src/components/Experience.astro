---
import { Image } from 'astro:assets';
import { EXPERIENCES, EDUCATION } from '../data/portfolio';
import bgPrism from '../assets/bg-futuristic-prism.jpg';
---

<section
  id="experience"
  class="relative bg-[#2C3531] text-[#D1E8E2] py-20 sm:py-28 border-b border-[#116466]/55 overflow-hidden"
>
  <!-- Matching Futuristic Geometric Prism Backdrop -->
  <Image
    src={bgPrism}
    alt=""
    widths={[768, 1376]}
    sizes="100vw"
    aria-hidden="true"
    class="absolute inset-0 w-full h-full object-cover opacity-25 -scale-x-100 pointer-events-none select-none"
    loading="lazy"
  />
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse 68% 58% at 78% 72%, rgba(17, 100, 102, 0.28), transparent 65%), linear-gradient(180deg, rgba(30, 37, 34, 0.85) 0%, rgba(44, 53, 49, 0.62) 50%, rgba(30, 37, 34, 0.88) 100%);"
    aria-hidden="true"
  ></div>
  <div class="absolute inset-0 film-grain opacity-60" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6">
    <!-- Section Header -->
    <div class="flex flex-wrap items-end justify-between gap-4 border-b border-[#116466]/70 pb-6 mb-14">
      <div>
        <p class="text-xs uppercase tracking-[0.22em] text-[#FFCB9A] font-semibold mb-2">
          03 // EXPERIENCE &amp; CAREER TIMELINE
        </p>
        <h2
          class="font-display font-bold tracking-[0.015em] leading-[1.1] text-[#D1E8E2]"
          style="font-size: clamp(1.85rem, 3.6vw, 3rem);"
        >
          7+ Years Across Edit Suites &amp; Delivery Ops.
        </h2>
      </div>
      <span class="font-mono-tech text-xs uppercase tracking-[0.16em] text-[#D9B08C]">
        CHRONOLOGY // 2017 &ndash; PRESENT
      </span>
    </div>

    <!-- Vertical Chronological Track -->
    <div class="relative pl-6 sm:pl-10 border-l border-[#116466] space-y-10">
      {EXPERIENCES.map((exp) => (
        <article class="relative group">
          <!-- Timeline Marker Node -->
          <span
            class:list={[
              'absolute -left-[31px] sm:-left-[47px] top-1.5 h-3.5 w-3.5 rounded-full border-2 transition-colors',
              exp.current
                ? 'bg-[#FFCB9A] border-[#1E2522] ring-4 ring-[#FFCB9A]/25'
                : 'bg-[#2C3531] border-[#116466] group-hover:border-[#FFCB9A] group-hover:bg-[#FFCB9A]',
            ]}
            aria-hidden="true"
          ></span>

          <div class="rounded-2xl border border-[#116466]/85 group-hover:border-[#FFCB9A] bg-[#1E2522]/80 backdrop-blur-sm p-6 sm:p-7 transition-colors">
            <div class="flex flex-wrap items-baseline justify-between gap-3 mb-3">
              <div>
                <h3 class="font-display font-bold text-xl sm:text-2xl text-[#D1E8E2] tracking-tight">
                  {exp.role}
                  <span class="text-[#FFCB9A]"> &middot; {exp.company}</span>
                </h3>
                <p class="text-xs uppercase tracking-[0.16em] text-[#D9B08C] mt-1">
                  {exp.location}
                </p>
              </div>

              <div class="flex items-center gap-2">
                {exp.current && (
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-[#FFCB9A] px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-[#1E2522]">
                    <span class="h-1.5 w-1.5 rounded-full bg-[#1E2522]" aria-hidden="true"></span>
                    Active
                  </span>
                )}
                <span class="rounded-md border border-[#116466] bg-[#2C3531] px-3 py-1 font-mono-tech text-xs font-semibold text-[#D1E8E2]">
                  {exp.period}
                </span>
              </div>
            </div>

            <ul class="mt-4 space-y-2 text-[#D1E8E2]/80 text-sm sm:text-base leading-relaxed">
              {exp.highlights.map((item) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-2 h-1.5 w-1.5 rounded-full bg-[#FFCB9A] shrink-0" aria-hidden="true"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <div class="mt-5 flex flex-wrap gap-2">
              {exp.tags.map((tag) => (
                <span class="rounded-full border border-[#116466] bg-[#2C3531]/80 px-3 py-0.5 text-xs text-[#D1E8E2]/90">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Verified Education Foundation -->
    <div class="mt-14 pt-10 border-t border-[#116466]/70">
      <p class="text-xs uppercase tracking-[0.2em] text-[#FFCB9A] font-semibold mb-5">
        ACADEMIC &amp; STUDIO TRAINING
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {EDUCATION.map((edu) => (
          <div class="rounded-2xl border border-[#116466]/85 bg-[#1E2522]/75 backdrop-blur-sm p-5 flex flex-col justify-between gap-3">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="font-display font-bold text-lg text-[#D1E8E2]">{edu.credential}</h3>
                <p class="text-sm font-medium text-[#FFCB9A] mt-0.5">{edu.institution}</p>
              </div>
              <span class="font-mono-tech text-xs text-[#D9B08C] shrink-0">{edu.period}</span>
            </div>
            <p class="text-xs uppercase tracking-wider text-[#D1E8E2]/70">
              {edu.location}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
